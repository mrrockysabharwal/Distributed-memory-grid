# Local development configuration. Copy to .env to override the defaults.
APP_NAME=Distributed Memory Grid (DMG) API Gateway
APP_DESCRIPTION=Real-time distributed LLM inference engine control plane and streaming gateway.
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite:///./data/inference_jobs.db

# Authentication placeholders - never use a real secret in this example file.
# Generate a secure random secret locally and provide it through the environment.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
